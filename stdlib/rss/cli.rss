use flint;

// Typed facade over the host-backed argparse reference API.
pub fn option<T>(
    parser: int,
    initial: T,
    names: [string],
    action: string,
    help: string
) -> int {
    let reference: int = flint::cli::refer(parser, initial);
    flint::cli::add_option(reference, names, action, help);
    reference
}

pub fn required_option<T>(
    parser: int,
    initial: T,
    names: [string],
    action: string,
    help: string
) -> int {
    let reference: int = option::<T>(parser, initial, names, action, help);
    flint::cli::required(reference);
    reference
}

pub fn get_string(reference: int) -> string {
    flint::cli::get_string(reference)
}

pub fn get_int(reference: int) -> int {
    flint::cli::get_int(reference)
}

pub fn get_float(reference: int) -> float {
    flint::cli::get_float(reference)
}

pub fn get_bool(reference: int) -> bool {
    flint::cli::get_bool(reference)
}
