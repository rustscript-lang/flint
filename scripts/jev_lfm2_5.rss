use stdlib::rss::cli as cli;
use flint;
use json;
use math;
use self::jev_math as decisions;

// Decisions share the verified LFM2.5 text forward path from lfm2_5.rss.
// This entry point intentionally has no token-generation loop.
struct Question {
    id: string,
    kind: string,
    prompt: string,
    choices: [string],
}
struct Request {
    state: string,
    questions: [Question],
}
struct Entry {
    label: string,
    probability: float,
    log_likelihood: float,
    ranking_score: float,
}
struct Answer {
    id: string,
    kind: string,
    selected: string,
    distribution: [Entry],
    calibrated: bool,
}
struct DecisionResponse {
    model: string,
    temperature: float,
    scoring: string,
    results: [Answer],
}

let parser: int = flint::cli::argument_parser();
flint::cli::set_description(parser, "Pure-RSS LFM2.5 typed decisions (uncalibrated)");
let weights_arg: int = cli::required_option::<string>(
    parser, "", ["-m", "--model"], "Store", "LFM2.5-230M safetensors"
);
let tokenizer_arg: int = cli::required_option::<string>(
    parser, "", ["--tokenizer"], "Store", "Matching tokenizer.json"
);
let request_arg: int = cli::required_option::<string>(
    parser, "", ["--request"], "Store", "Decision request JSON"
);
let temperature_arg: int = cli::option::<float>(
    parser, 1.0, ["--temperature"], "Store", "Positive temperature; no calibration claim"
);
let scoring_arg: int = cli::option::<string>(
    parser, "token-mean", ["--scoring"], "Store", "token-mean or total"
);
flint::cli::parse_args(parser);
let weights_path: string = cli::get::<string>(weights_arg);
let tokenizer_path: string = cli::get::<string>(tokenizer_arg);
let request_text: string = cli::get::<string>(request_arg);
let temperature: float = cli::get::<float>(temperature_arg);
let scoring: string = cli::get::<string>(scoring_arg);
let request: Request = json::decode::<Request>(request_text);
assert(temperature > 0.0 && math::is_finite(temperature));
assert(scoring == "total" || scoring == "token-mean");
let question_count: int = request.questions.copy().length;
assert(question_count > 0 && question_count <= 32);
assert(request.state.copy().length <= 8192);
let mut validated: int = 0;
while validated < question_count {
    let question: Question = request.questions.copy()[validated];
    assert(question.id.copy().length > 0 && question.prompt.copy().length > 0);
    let labels: [string] = question_labels(question.copy());
    assert(labels.length > 0);
    let mut earlier: int = 0;
    while earlier < validated {
        assert(question.id.copy() != request.questions.copy()[earlier].id);
        earlier = earlier + 1;
    }
    validated = validated + 1;
}
let model_kind: int = 0;
let image_path: string = "";
flint::weights::load(weights_path);
flint::tokenizer::load(tokenizer_path);

fn is_vl_model() -> bool {
    model_kind == 1
}

fn model_prefix() -> string {
    if is_vl_model() => {
        "model.language_model"
    } else => {
        "model"
    }
}

fn text_key(name: string) -> string {
    model_prefix() + "." + name
}

fn text_weight(name: string) -> int {
    let handle: int = flint::weights::get(text_key(name));
    handle
}

fn text_optional_weight(name: string) -> int {
    let handle: int = flint::weights::get_optional(text_key(name));
    handle
}

fn vl_weight(name: string) -> int {
    let handle: int = flint::weights::get_optional("model." + name);
    handle
}

fn linear(input: int, weight_handle: int) -> int {
    flint::nn::linear(input, weight_handle, 0)
}

fn linear_bias(input: int, weight_handle: int, bias_handle: int) -> int {
    flint::nn::linear(input, weight_handle, bias_handle)
}

fn rms_norm(input: int, weight_handle: int) -> int {
    flint::nn::rms_norm(input, weight_handle, 0.00001)
}

fn add_rms_norm(input: int, residual: int, weight_handle: int) -> int {
    flint::nn::add_rms_norm(input, residual, weight_handle, 0.00001)
}

fn layer_norm(input: int, weight_handle: int, bias_handle: int, hidden_size: int) -> int {
    flint::nn::layer_norm(input, weight_handle, bias_handle, 0.000001, hidden_size)
}

fn apply_rope_pair(query: int, key: int, cos: int, sin: int) -> int {
    flint::nn::apply_rope_pair(query, key, cos, sin)
}

fn repeat_kv(input: int) -> int {
    flint::tensor::repeat_interleave(input, 2, 1)
}

let embed_weight: int = text_weight("embed_tokens.weight");
let embedding_norm_weight: int = text_weight("embedding_norm.weight");
let lm_head_weight: int = embed_weight;

fn token_embeddings(input_ids: int) -> int {
    let weight: int = text_weight("embed_tokens.weight");
    flint::nn::embedding(input_ids, weight)
}

fn final_norm(input: int) -> int {
    let weight: int = text_weight("embedding_norm.weight");
    rms_norm(input, weight)
}

fn lm_head(input: int) -> int {
    let weight: int = text_weight("embed_tokens.weight");
    flint::nn::linear(input, weight, 0)
}

